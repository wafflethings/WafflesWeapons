    - target: {fileID: 8402381437253185924, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_text
      value: 'Hold Alt Fire to launch a powerful, <color=orange>piercing</color>
        rocket.


        Charge length affects damage, size, and explosion size.'
      objectReference: {fileID: 0}
