        type: 3}
      propertyPath: m_text
      value: 'Press Alt Fire to <color=orange>launch</color> a black hole, charged
        with blood.


        It bounces on walls and attracts enemies when shot.
        Parrying will redirect it.'
      objectReference: {fileID: 0}
