      propertyPath: weaponName
      value: nai6
      objectReference: {fileID: 0}
    - target: {fileID: 6564064576393635769, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_SizeDelta.y
      value: 1404.3
      objectReference: {fileID: 0}
    - target: {fileID: 6840613696959850645, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_text
      value: CONDUCTOR
      objectReference: {fileID: 0}
    - target: {fileID: 6855963822826908850, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_text
      value: "<color=orange>DATA:</color>\nThis weapon uses electricity to stun enemies.
        For husks, this works similarly to a tazer, whereas for machines, it supplies
        such high voltages that their systems break temporarily.\n\n<color=orange>STRATEGY:</color>\n-
        As stunned enemies are unable to dodge, they are susceptible to further stunning
        attacks. Effective use can lock them in a stunned state.\n\n- Stunned enemies
        are affected by gravity, making aerial enemies easier to reach.\n\n- The
        nailgun's stunning beam stuns for longer and does more damage based on charge.\n\n-
        When a rocket is shot with the nailgun's beam, it will become faster, and
        explode in a blue explosion that stuns.\n\n- When a core is shot with the
        nailgun's beam, it will explode in a blue explosion that stuns.\n\n- When
        a projectile is shot with the nailgun's beam, it will face where the user
        is looking - as if it was parried - and explode in a blue explosion that
        stuns. \n\n- When a magnet or singularity is shot with the beam, all enemies
        in a nearby radius will be stunned, and receive damage. This scales with
        the beam's charge.\n\n- The sawblade launcher's stunning saws are larger,
        deal more damage, and stun for longer, based on charge.\n\n- They are especially
        effective with magnets, as they can hit an enemy several times.\n\n- At full
        charge, both the nailgun's beam and sawblade launcher's saws will explode
        on contact with enemies or the environment. These explosions can stun many
        enemies at a time. "
      objectReference: {fileID: 0}
    - target: {fileID: 7170365296153474310, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: weaponName
      value: nai4
      objectReference: {fileID: 0}
    - target: {fileID: 7682565424674736954, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7724210255063270396, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: c5439bf75c1deb54baae9c142d98bbb2,
        type: 3}
    - target: {fileID: 7764247037255005094, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8402381437253185924, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_text
      value: 'Hold Alt Fire to charge a beam that <color=orange>stuns</color> enemies.


        At
        full charge, the beam will <color=orange>explode</color> with a stunning
        explosion on hit.'
      objectReference: {fileID: 0}
