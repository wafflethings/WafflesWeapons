    - target: {fileID: 1039808519389904718, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
      propertyPath: m_text
      value: '<color=orange>Hold</color> Alt Fire to charge a downsized <color=orange>malicious</color>
        beam.


        Due to its somewhat <color=orange>low</color> damage output,
        the beam is useful for <color=orange>movement</color>.'
      objectReference: {fileID: 0}
    - target: {fileID: 1151136569731958781, guid: 21a46dfea5bdae243bc5093848184b2a,
        type: 3}
